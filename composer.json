{
    "name": "shipbytes/blade-ui",
    "description": "Blade UI components for Laravel — 41 accessible components with design tokens, dark mode and Tailwind v4 CSS included. Presentation only: no Livewire, no state.",
    "keywords": [
        "laravel",
        "blade",
        "blade-components",
        "design-system",
        "tailwindcss",
        "tailwind",
        "ui-kit",
        "design-tokens",
        "alpinejs"
    ],
    "homepage": "https://github.com/shipbytes/design-system",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Abhishek",
            "email": "abhiguess@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/shipbytes/design-system/issues",
        "source": "https://github.com/shipbytes/design-system",
        "docs": "https://github.com/shipbytes/design-system/tree/master/docs"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0",
        "blade-ui-kit/blade-heroicons": "^2.4"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Shipbytes\\BladeUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shipbytes\\BladeUi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shipbytes\\BladeUi\\BladeUiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
